# ---- Server ----
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# ---- Logging ----
LOG_LEVEL=info

# ---- Business Rules ----
MAX_INVOICE_ITEMS=50
INVOICE_CURRENCY=USD

# ---- Auth ----
# Set a non-empty value to enable API key checks in production.
# Leave blank to disable auth (development only).
API_KEY=

# ---- Misc ----
NODE_ENV=development
